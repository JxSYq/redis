+    NULL,                       /* val dup */
+    dictSdsKeyCaseCompare,      /* key compare (case-insensitive) */
+    dictSdsDestructor,          /* key destructor (free SDS keys) */
+    NULL,                       /* val destructor (values are string literals) */
+    NULL                        /* allow to expand */
+};
