 src/audit.h              |   7 +++
 src/config.c             |   2 +-
 src/server.c             |   5 ++
 src/server.h             |   2 +
 tests/unit/audit-log.tcl |  64 +++++++++++++++++++++++
 6 files changed, 186 insertions(+), 2 deletions(-)

