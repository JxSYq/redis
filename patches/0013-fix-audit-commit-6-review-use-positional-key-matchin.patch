         keys[0] = sdsnew(argv[1]->ptr); /* destkey */
+        (*key_positions)[0] = 1;
         for (int i = 0; i < (int)nkeys; i++) {
             keys[i + 1] = sdsnew(argv[3 + i]->ptr);
+            (*key_positions)[i + 1] = 3 + i;
         }
         return keys;
     }
@@ -843,8 +853,10 @@ sds *auditExtractKeys(client *c, int *numkeys) {
