     }
@@ -885,8 +903,11 @@ sds *auditExtractKeys(client *c, int *numkeys) {
         if (argc < 3) return NULL;
         *numkeys = 2;
         keys = zmalloc(sizeof(sds) * 2);
+        *key_positions = zmalloc(sizeof(int) * 2);
