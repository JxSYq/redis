     }
@@ -935,17 +960,20 @@ sds *auditExtractKeys(client *c, int *numkeys) {
     /* Default: single key command, first argument is the key */
     *numkeys = 1;
     keys = zmalloc(sizeof(sds));
+    *key_positions = zmalloc(sizeof(int));
